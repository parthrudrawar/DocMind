FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/  ./app/
COPY .env  .env

RUN mkdir -p data/uploads data/indexes data/db

# Single threaded worker (NOT 4 forked processes) so the ML model is loaded
# only ONCE in memory — critical for fitting a 2 GB VPS.
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info", "--pool=threads", "--concurrency=2"]
