# Reference for this approved preview branch's root .streamlit/config.toml.
# This example is not automatically loaded by Streamlit.
# Do not overwrite main/live configuration. 100 MB is acceptance only,
# not a promise that free hosting can parse/index every document of that size.
[server]
maxUploadSize = 100
maxMessageSize = 10
enableCORS = true
enableXsrfProtection = true
enableStaticServing = false

[client]
showErrorDetails = false

[theme]
base = "dark"
primaryColor = "#818cf8"
backgroundColor = "#0e1117"
secondaryBackgroundColor = "#171d2b"
textColor = "#e2e8f0"
